# BioSentinel-X System Environment Configuration

# Database Configuration (Development Fallback: SQLite)
# For Cloud DB (e.g. PostgreSQL, Supabase, AWS RDS):
# DATABASE_URL=postgresql://user:password@cloud-db-host:5432/biosentinel_db
DATABASE_URL=sqlite:///biosentinel.db

# Cloud Object Storage Configuration (Optional)
# If provided, uploaded waste images will be stored in Cloud Storage.
# If omitted or unconfigured, local persistent storage is used automatically with "LOCAL STORAGE" status.
STORAGE_PROVIDER=S3
STORAGE_URL=https://my-bucket.s3.amazonaws.com
STORAGE_BUCKET=biosentinel-waste-images
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ML Model Settings
ML_MODEL_FILE=best.pt
ML_CONFIDENCE_THRESHOLD=0.50

# Application Security
SECRET_KEY=biosentinelx_secret_key_super_secure_2026
